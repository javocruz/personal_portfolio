{
  "name": "personal-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Keep variables that are set in the Cloudflare dashboard (FORWARD_TO) when deploying from git.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker; everything else is served straight from the static assets.
    "run_worker_first": ["/api/*"]
  },
  // Sends the contact-form email through Email Routing (only to verified destination addresses).
  "send_email": [{ "name": "EMAIL" }],
  // Rate limit for the contact form: 3 messages a minute per visitor.
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    // the guestbook: 2 signatures a minute per visitor
    { "name": "GUESTBOOK_LIMIT", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } }
  ],
  // the guestbook lives in one Durable Object with its own SQLite storage (worker/guestbook.ts)
  "durable_objects": { "bindings": [{ "name": "GUESTBOOK", "class_name": "Guestbook" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Guestbook"] }],
  // Branch/PR preview deployments ("wrangler preview") need their own copy of the bindings.
  "previews": {
    "send_email": [{ "name": "EMAIL" }]
  }
}
